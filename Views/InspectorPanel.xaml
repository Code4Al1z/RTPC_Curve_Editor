<UserControl x:Class="RTPCCurveEditor.Views.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RTPCCurveEditor.Views">

	<Border Background="#13131A" BorderBrush="#2A2A38" BorderThickness="1,0,0,0">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="12,10">

				<!-- Section: Selected point -->
				<TextBlock Text="POINT" FontSize="10" FontWeight="SemiBold"
						   Foreground="#4A4860" Margin="0,0,0,8"/>

				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="32"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Label Content="X" Grid.Column="0" VerticalAlignment="Center"/>
					<TextBox Grid.Column="1"
							 Text="{Binding SelectedPointRealX, StringFormat=F2,
                          UpdateSourceTrigger=PropertyChanged, FallbackValue='—'}"
							 IsEnabled="{Binding SelectedPoint, Converter={StaticResource NullToBool}}"/>
				</Grid>

				<Grid Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="32"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Label Content="Y" Grid.Column="0" VerticalAlignment="Center"/>
					<TextBox Grid.Column="1"
							 Text="{Binding SelectedPointRealY, StringFormat=F2,
                          UpdateSourceTrigger=PropertyChanged, FallbackValue='—'}"
							 IsEnabled="{Binding SelectedPoint, Converter={StaticResource NullToBool}}"/>
				</Grid>

				<Separator/>

				<!-- Section: Curve -->
				<TextBlock Text="CURVE" FontSize="10" FontWeight="SemiBold"
						   Foreground="#4A4860" Margin="0,10,0,8"/>

				<Label Content="Name" Margin="0,0,0,2"/>
				<TextBox Text="{Binding ActiveCurve.Name, UpdateSourceTrigger=PropertyChanged}"
						 Margin="0,0,0,8"/>

				<Label Content="Colour" Margin="0,0,0,2"/>
				<DockPanel Margin="0,0,0,12">
					<views:ColorPickerButton ColorHex="{Binding ActiveCurve.ColorHex, Mode=TwoWay}"
											  DockPanel.Dock="Left" Margin="0,0,8,0"/>
					<TextBox Text="{Binding ActiveCurve.ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
				</DockPanel>

				<Separator/>

				<!-- Section: RTPC mapping -->
				<TextBlock Text="RTPC MAPPING" FontSize="10" FontWeight="SemiBold"
						   Foreground="#4A4860" Margin="0,10,0,8"/>

				<Label Content="Wwise RTPC name" Margin="0,0,0,2"/>
				<TextBox Text="{Binding Document.WwiseRtpcName, UpdateSourceTrigger=PropertyChanged}"
						 Margin="0,0,0,8"/>

				<Grid Margin="0,0,0,4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<Label Content="Input min"/>
						<TextBox Text="{Binding InputMinField, UpdateSourceTrigger=LostFocus}" KeyDown="OnRangeFieldKeyDown"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<Label Content="Input max"/>
						<TextBox Text="{Binding InputMaxField, UpdateSourceTrigger=LostFocus}" KeyDown="OnRangeFieldKeyDown"/>
					</StackPanel>
				</Grid>

				<Grid Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="8"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<Label Content="Output min"/>
						<TextBox Text="{Binding OutputMinField, UpdateSourceTrigger=LostFocus}" KeyDown="OnRangeFieldKeyDown"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<Label Content="Output max"/>
						<TextBox Text="{Binding OutputMaxField, UpdateSourceTrigger=LostFocus}" KeyDown="OnRangeFieldKeyDown"/>
					</StackPanel>
				</Grid>

				<Separator/>

				<Separator/>

				<!-- Section: Native C++ Evaluation (P/Invoke) -->
				<TextBlock Text="NATIVE C++ EVALUATION (P/INVOKE)" FontSize="10" FontWeight="SemiBold"
						   Foreground="#7F77DD" Margin="0,10,0,8"/>

				<TextBlock Text="Native evaluator unavailable — build RTPCCurveEvaluatorNative for the x64 platform to enable this section."
						   FontSize="10" Foreground="#8A88A0" TextWrapping="Wrap" Margin="0,0,0,12"
						   Visibility="{Binding NativeEvaluatorAvailable, Converter={StaticResource InverseBoolToVis}}"/>

				<StackPanel Visibility="{Binding NativeEvaluatorAvailable, Converter={StaticResource BoolToVis}}">
					<DockPanel Margin="0,0,0,4">
						<Label Content="Input value" Padding="0" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding NativeTestInputReal, StringFormat={}{0:F2}}"
								   Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
								   HorizontalAlignment="Right" VerticalAlignment="Center"/>
					</DockPanel>

					<Slider Minimum="0.0" Maximum="1.0"
							Value="{Binding NativeTestInput, Mode=TwoWay}"
							TickFrequency="0.01" IsSnapToTickEnabled="False"
							Margin="0,4,0,8"/>

					<Border Background="#1A1A24" CornerRadius="4" Padding="8" Margin="0,0,0,12">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Normalized Y" FontSize="10" Foreground="#8A88A0"/>
								<TextBlock Text="{Binding NativeTestOutput, StringFormat={}{0:F3}}"
										   FontSize="13" FontWeight="Bold" Foreground="#10B981"/>
							</StackPanel>

							<StackPanel Grid.Column="1">
								<TextBlock Text="Real Output" FontSize="10" Foreground="#8A88A0"/>
								<TextBlock Text="{Binding NativeTestOutputReal, StringFormat={}{0:F1}}"
										   FontSize="13" FontWeight="Bold" Foreground="#3B82F6"/>
							</StackPanel>
						</Grid>
					</Border>
				</StackPanel>

				<!-- Section: Comparison curves -->
				<TextBlock Text="COMPARISON CURVES" FontSize="10" FontWeight="SemiBold"
						   Foreground="#4A4860" Margin="0,10,0,8"/>

				<ItemsControl ItemsSource="{Binding AllCurves}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,2" Padding="8,6" CornerRadius="4"
									BorderThickness="1" Cursor="Hand"
									MouseLeftButtonUp="OnCurveRowClick"
									ToolTip="Click to make this the active curve">
								<Border.BorderBrush>
									<MultiBinding Converter="{StaticResource ActiveCurveBorder}">
										<Binding/>
										<Binding Path="DataContext.ActiveCurve" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
									</MultiBinding>
								</Border.BorderBrush>
								<Border.Background>
									<MultiBinding Converter="{StaticResource ActiveCurveBorder}" ConverterParameter="background">
										<Binding/>
										<Binding Path="DataContext.ActiveCurve" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
									</MultiBinding>
								</Border.Background>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="10"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2"
											   VerticalAlignment="Center" Margin="0,0,6,0">
										<Rectangle.Fill>
											<SolidColorBrush Color="{Binding ColorHex}"/>
										</Rectangle.Fill>
									</Rectangle>
									<TextBlock Grid.Column="1" Text="{Binding Name}"
											   FontSize="12" VerticalAlignment="Center"/>
									<CheckBox Grid.Column="2" IsChecked="{Binding IsVisible}"
											  VerticalAlignment="Center" Margin="0,0,6,0"/>
									<Button Grid.Column="3" Content="✕" FontSize="10"
											Command="{Binding DataContext.RemoveCurveCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
											CommandParameter="{Binding}"
											Style="{StaticResource GhostButton}"
											Padding="4,2" VerticalAlignment="Center"/>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Button Content="+ Add curve"
						Command="{Binding AddComparisonCurveCommand}"
						Style="{StaticResource GhostButton}"
						Margin="0,8,0,0"/>

				<Separator Margin="0,12,0,8"/>

				<!-- Clear curve -->
				<Button Content="Clear curve"
						Command="{Binding ClearCurveCommand}"
						Style="{StaticResource GhostButton}"
						Margin="0,0,0,12"/>

				<!-- Export shortcuts -->
				<TextBlock Text="EXPORT" FontSize="10" FontWeight="SemiBold"
						   Foreground="#4A4860" Margin="0,0,0,8"/>

				<Button Content="Export Wwise XML"
						Command="{Binding ExportWwiseXmlCommand}"
						Style="{StaticResource GhostButton}"
						Margin="0,0,0,4"/>
				<Button Content="Export JSON"
						Command="{Binding ExportJsonCommand}"
						Style="{StaticResource GhostButton}"
						Margin="0,0,0,4"/>
				<Button Content="Export PNG"
						Command="{Binding ExportPngCommand}"
						Style="{StaticResource GhostButton}"
						Margin="0,0,0,0"/>

			</StackPanel>
		</ScrollViewer>
	</Border>
</UserControl>