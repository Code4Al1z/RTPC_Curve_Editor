<UserControl x:Class="RTPCCurveEditor.Views.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RTPCCurveEditor.Views"
             x:Name="Root">
	<Grid>
		<ToggleButton x:Name="SwatchToggle" Width="28" Height="28" Cursor="Hand"
                      ToolTip="Choose curve colour">
			<ToggleButton.Template>
				<ControlTemplate TargetType="ToggleButton">
					<Border CornerRadius="4" BorderBrush="#3A3850" BorderThickness="1"
                            Background="{Binding SwatchBrush, ElementName=Root}"/>
				</ControlTemplate>
			</ToggleButton.Template>
		</ToggleButton>

		<!-- StaysOpen is intentionally True: a StaysOpen="False" Popup closes
             unexpectedly the moment a Slider inside it captures the mouse for
             a drag, a well-known WPF interaction bug. Click the swatch again
             (or pick a preset/type a hex value) to close instead. -->
		<Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchToggle}"
               Placement="Bottom" StaysOpen="True"
               IsOpen="{Binding IsChecked, ElementName=SwatchToggle, Mode=TwoWay}">
			<Border Background="#1A1A24" BorderBrush="#3A3850" BorderThickness="1"
                    CornerRadius="6" Padding="12" Width="200">
				<StackPanel>
					<TextBlock Text="PRESETS" FontSize="9" FontWeight="SemiBold"
                               Foreground="#4A4860" Margin="0,0,0,6"/>

					<ItemsControl ItemsSource="{x:Static local:ColorPickerButton.PresetColors}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button Width="24" Height="24" Margin="2" Padding="0"
                                        Tag="{Binding}" Click="OnPresetClick"
                                        BorderBrush="#3A3850" BorderThickness="1"
                                        Cursor="Hand">
									<Button.Background>
										<SolidColorBrush Color="{Binding}"/>
									</Button.Background>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="CUSTOM" FontSize="9" FontWeight="SemiBold"
                               Foreground="#4A4860" Margin="0,12,0,6"/>

					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="28"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="R" Foreground="#E5484D" FontSize="10" VerticalAlignment="Center"/>
						<Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="OnSliderChanged" Margin="4,0"/>
						<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RSlider, StringFormat={}{0:F0}}"
                                   FontSize="10" VerticalAlignment="Center" Foreground="#8A88A0"/>
					</Grid>

					<Grid Margin="0,0,0,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="28"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="G" Foreground="#30A46C" FontSize="10" VerticalAlignment="Center"/>
						<Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="OnSliderChanged" Margin="4,0"/>
						<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GSlider, StringFormat={}{0:F0}}"
                                   FontSize="10" VerticalAlignment="Center" Foreground="#8A88A0"/>
					</Grid>

					<Grid Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="28"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="B" Foreground="#3B82F6" FontSize="10" VerticalAlignment="Center"/>
						<Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255"
                                ValueChanged="OnSliderChanged" Margin="4,0"/>
						<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BSlider, StringFormat={}{0:F0}}"
                                   FontSize="10" VerticalAlignment="Center" Foreground="#8A88A0"/>
					</Grid>

					<Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Right"
                            Style="{StaticResource GhostButton}"
                            Padding="10,3" FontSize="10"/>
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>